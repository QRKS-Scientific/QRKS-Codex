# Copy to .env and fill in. NEVER commit .env.
# Public name of the server (it must point at this machine's public IP before the first start).
QRKS_DOMAIN=qrks-example.duckdns.org
# Required: at least 32 random characters.   openssl rand -hex 32
QRKS_JWT_SECRET=
# Optional extra secret mixed into password hashing.   openssl rand -hex 32
# Changing it later invalidates every password, so set it once before `init`.
QRKS_PEPPER=
QRKS_MIN_APP_VERSION=0.5.0
# QRKS_TIMEZONE=Asia/Manila
